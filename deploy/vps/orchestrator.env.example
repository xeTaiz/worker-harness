# Copy to orchestrator.env (chmod 600). Never commit the filled-in file.

# wh-hs tailnet. Single-use, tag-only key for tag:wh-orchestrator, needed only
# for the first join; the identity then persists in volumes/tailscale. Once the
# node shows up in `headscale nodes list`, clear TS_AUTHKEY again: restarts
# reuse the saved state, and the orchestrator tag grants SSH to every worker.
TS_HOST=https://wh-hs.d0me.xyz
TS_AUTHKEY=
# Workers use ORCHESTRATOR_HOST=orchestrator.wh.d0me.xyz.
TS_HOSTNAME=orchestrator

# Exact public HTTPS origin served by SWAG (no path or trailing slash).
WH_WEB_ORIGIN=https://worker-harness.d0me.xyz
