# The root build context is shared by the orchestrator and wh-web
# images. Keep it allowlisted so local SIFs, caches, git history, and
# deployment data can never be sent to the Docker daemon.
**

!pyproject.toml
!src/
!src/**
!orchestrator_container/
!orchestrator_container/**
!web/
!web/**
!web_container/
!web_container/**

**/__pycache__/
**/*.py[cod]
